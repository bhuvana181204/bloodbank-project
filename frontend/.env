# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL — backend API base URL
#
# Default is localhost — works on your laptop immediately after npm install.
# For mobile QR scanning on the same WiFi, run setup-mobile-qr.bat (Windows)
# or setup-mobile-qr.sh (Mac/Linux) — it will auto-patch this file with your
# LAN IP (e.g. http://192.168.1.5:5000/api).
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
